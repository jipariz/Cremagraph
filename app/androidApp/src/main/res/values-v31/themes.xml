<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: the mark records its shot in the system splash (design/splash/avd.py), for at most a second. -->
    <style name="Theme.OnlyShots.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.OnlyShots</item>
    </style>
</resources>
